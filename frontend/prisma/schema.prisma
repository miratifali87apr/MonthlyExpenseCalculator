generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties Property[]
  expenses   ExpenseItem[]
  income     IncomeItem[]
  templates  RecurringTemplate[]

  @@map("users")
}

model Property {
  id                   Int      @id @default(autoincrement())
  userId               Int?     @map("user_id")
  name                 String
  address              String?
  tenantLiableForWater Boolean  @default(false) @map("tenant_liable_for_water")
  weeklyRent           Decimal? @default(0) @map("weekly_rent") @db.Decimal(10, 2)
  pmFeePct             Decimal? @default(0) @map("pm_fee_pct") @db.Decimal(5, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  ExpenseItem[]
  income    IncomeItem[]
  templates RecurringTemplate[]

  @@map("properties")
}

model RecurringTemplate {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  name        String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  frequency   String   @default("monthly")
  dayOfMonth  Int?     @map("day_of_month")
  monthOfYear Int?     @map("month_of_year")
  propertyId  Int?     @map("property_id")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id])
  expenses ExpenseItem[]

  @@map("recurring_templates")
}

model ExpenseItem {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  name        String
  category    String
  amount      Decimal   @db.Decimal(10, 2)
  amountPaid  Decimal?  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  dueDate     DateTime  @map("due_date")
  paidDate    DateTime? @map("paid_date")
  status      String    @default("pending")
  notes       String?
  propertyId  Int?      @map("property_id")
  templateId  Int?      @map("template_id")
  isRecurring Boolean   @default(false) @map("is_recurring")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property?          @relation(fields: [propertyId], references: [id])
  template RecurringTemplate? @relation(fields: [templateId], references: [id])

  @@map("expense_items")
}

model IncomeItem {
  id                  Int       @id @default(autoincrement())
  userId              Int?      @map("user_id")
  name                String
  type                String
  amount              Decimal   @db.Decimal(10, 2)
  receivedDate        DateTime? @map("received_date")
  expectedDate        DateTime? @map("expected_date")
  propertyId          Int?      @map("property_id")
  reimbursementStatus String?   @map("reimbursement_status")
  notes               String?
  isRecurring         Boolean   @default(false) @map("is_recurring")
  frequency           String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id])

  @@map("income_items")
}
